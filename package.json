{
  "name": "telmaa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flatten-segment-prefetch.mjs && node scripts/generate-csp.mjs",
    "start": "next start",
    "preview:headers": "node scripts/serve-with-headers.mjs",
    "lint": "eslint",
    "deploy": "npm run build && npm run validate:build-security && wrangler pages deploy out --project-name=telma-santos --branch=main && npm run check:production",
    "typecheck": "tsc --noEmit",
    "validate:build-security": "node scripts/validate-build-security.mjs",
    "check:production": "node scripts/check-production.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "motion": "^13.1.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.136.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
