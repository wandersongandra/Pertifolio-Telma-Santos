# Cloudflare Pages security and caching headers.
#
# This file is copied verbatim into the build output (out/_headers) and is what
# Cloudflare Pages reads — nothing here is applied by `next dev` or `next start`.
# To exercise these headers locally against a real build, run:
#
#     npm run build && npm run preview:headers
#
# CSP notes:
# 'unsafe-inline' on script-src/style-src is required: this is a Next.js
# static export (output: "export"), so there is no server to emit per-request
# nonces, and the build ships an inline RSC hydration payload
# (self.__next_f.push(...)) plus inline style="" attributes from Motion.
# Removing 'unsafe-inline' breaks hydration and all animations.
# Everything else is locked to 'self': the site loads no third-party script,
# stylesheet, font, image or XHR. Fonts are self-hosted by next/font at build
# time, so font-src does not need fonts.gstatic.com.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Content-hashed by the build, so the filename changes whenever the bytes do.
# Safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# NOT content-hashed: these keep the same filename when the file is replaced
# (telma-hero-vignette.png stays telma-hero-vignette.png). Caching them as
# immutable would leave visitors on an old photo or logo for up to a year with
# no way to bust it. One day, then revalidate.
/telma/*
  Cache-Control: public, max-age=86400, must-revalidate
