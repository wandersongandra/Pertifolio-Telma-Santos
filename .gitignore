# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# original source photos (unorganized originals, kept as a local backup)
/_source-assets

# playwright mcp scratch output
/.playwright-mcp/

# one-off local asset scripts (icons/webp/optimizacao)
/_tmp-*.mjs

# Cópias de conflito do Google Drive. Este repositório vive dentro de "Meu
# Drive", e quando o Drive detecta divergência ele não avisa: cria um irmão
# chamado "arquivo (1).ts" ao lado do original. Dentro de app/ isso é pior que
# desordem — o roteador do Next varre a pasta, e um "robots (1).ts" perdido ali
# entra no build. Já aconteceu em 28/08/2026 e quebrou a checagem de tipos.
*\ (1).*
*\ (2).*
*\ (3).*
